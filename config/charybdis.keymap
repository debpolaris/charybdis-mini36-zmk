#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>



//roll 
#undef ZMK_POINTING_DEFAULT_MOVE_VAL
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000
#undef ZMK_POINTING_DEFAULT_SCRL_VAL
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12


&lt {
    tapping-term-ms = <220>;
    flavor = "balanced";
    quick-tap-ms = <200>;             //150에서 200으로 상향 조정 (연타 인식 범위 확대)
};

&msc {
    acceleration-exponent = <2>;      // 0
    time-to-max-speed-ms = <100>;     // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <300>;     //최고 속도 도달 시간: 가속이 붙는 '예열 시간'
    acceleration-exponent = <2>;      //가속 지수: 1이상 높게 설정하면 빠르게 굴릴 때 커서가 훨씬 더 멀리 이동
    trigger-period-ms = <16>;         //마우스 위치 보고 주기
};


&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };



/ {
    behaviors {
        //hm: home_row_mods {
        //    compatible = "zmk,behavior-hold-tap";
        //    #binding-cells = <2>;
        //    tapping-term-ms = <280>;        // 누르는 시간 기준 (약간 길게 잡는 것이 오입력 방지에 유리)
        //    quick-tap-ms = <250>;           // 연타 시에는 모디파이어가 아닌 알파벳이 나가게 함
        //    require-prior-idle-ms = <150>;  // 타이핑 중 오입력 방지 핵심 설정
        //    flavor = "balanced";            // 탭과 홀드 사이의 균형을 잡는 설정
        //    //flavor = "tap-unless-interrupted";
        //    bindings = <&kp>, <&kp>;
        //};

        // 왼손용 HRM (오른쪽 키들에만 반응)
        hml: left_home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;        //280
            quick-tap-ms = <200>;           //250
            require-prior-idle-ms = <150>;  //150
            flavor = "tap-preferred";       //balanced
            bindings = <&kp>, <&kp>;
            //hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;  //오른쪽 전체(+오른쪽 엄지)
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35>;           //오른쪽 전체(-오른쪽 엄지)
            hold-trigger-on-release;
        };

        // 오른손용 HRM (왼쪽 키들에만 반응)
        hmr: right_home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
            //hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;  //왼쪽 전체(+왼쪽 엄지)
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29>;             //왼쪽 전체(-왼쪽 엄지)
            hold-trigger-on-release;
        };

        
        // 앞서 만든 lang_tab 설정 유지
        lang_tab: lang_tab {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>; //200
            quick-tap-ms = <150>;               // 중요: 연타 시 Tab이 연속 입력되도록 함 175
            require-prior-idle-ms = <125>;      // 중요: 이전 타이핑 후 최소 0.125초는 쉬어야 한영전환 발동
            flavor = "balanced";                // Alt와 조합 시 더 정확하게 반응하도록 변경 balanced
            bindings = <&kp>, <&lang_change>;   // 홀드 시 파라미터(TAB), 탭 시 한영전환
        };


        // 탭 시 붙여넣기, 홀드 시 컨트롤
        ctp: ctrl_paste {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&paste_macro>;
        };


        // 탭 시 |(파이프), Shift 조합 시 \(백슬래시)
        p_slash: pipe_slash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PIPE>, <&kp BSLH>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };


        // 탭 시 복사(Ctrl+Ins), 홀드 시 PrintScreen (HRM 조합 가능)
        cpps: copy_pscrn {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <300>;     // 0.3초 이상 누르면 PSCRN 발동
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };


        // 방향키 전용 홀드탭: 탭 시 방향키, 홀드 시 특수 이동
        nav_hp: nav_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "hold-preferred";   // 이동 기능이므로 홀드를 약간 우선시
            bindings = <&kp>, <&kp>;
        };


        // 탭 시 DEL, 1.2초 홀드 시 CAD (Ctrl+Alt+Del)
        del_cad: delete_cad {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <1200>;        // 특정 시간 동안 눌러야 CAD 발동
            quick-tap-ms = <200>;            // DEL 연타를 위해 설정 150? 200?
            flavor = "tap-preferred";        // 일반적인 타이핑(DEL)을 우선시
            //bindings = <&kp>, <&kp>;
            bindings = <&cad_macro>, <&kp>;  // ZMK 파서 에러방지
        };


        // 탭 시 =, Shift 조합 시 ~
        eq_tilde: eq_tilde {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp TILDE>;    // 기본은 =, Shift 조합 시 ~
            mods = <(MOD_LSFT|MOD_RSFT)>;           // 양쪽 Shift 모두 대응
        };


    };



    macros {
        // Shift + Space (윈도우/안드로이드 공용 한영전환)
        //lang_change: lang_change {
        //    compatible = "zmk,behavior-macro";
        //    #binding-cells = <0>;
        //    bindings = <&macro_press &kp LSHFT>, <&macro_tap &kp SPC>, <&macro_release &kp LSHFT>;
        //};
lang_change: lang_change {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <0>;
    tap-ms = <1>;
    bindings = <&kp LS(SPC)>; // ZMK의 내부 단축어 기능을 사용해 최대한 빠르게 처리
};


        // Shift + Insert (붙여넣기)
        paste_macro: paste_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LSHFT>, <&macro_tap &kp INS>, <&macro_release &kp LSHFT>;
        };


        // LC(LALT(DEL))
        cad_macro: cad_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings 
               = <&macro_press &kp LCTRL &kp LALT>
               , <&macro_tap &kp DEL>
               , <&macro_release &kp LCTRL &kp LALT>
               ;
        };


//    // 上下滚动编码器行为
//    scroll_vertical_encoder: scroll_vertical_encoder {
//        compatible = "zmk,behavior-sensor-rotate";
//        #sensor-binding-cells = <0>;
//        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
//        tap-ms = <100>;
//    };
//
//    // 左右滚动编码器行为
//    scroll_horizontal_encoder: scroll_horizontal_encoder {
//        compatible = "zmk,behavior-sensor-rotate";
//        #sensor-binding-cells = <0>;
//        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
//        tap-ms = <100>;
//    };


    };



    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            label = "Base";
            bindings = <
&cpps PSCRN LC(INS) &kp Q       &kp W       &kp E        &kp R        &kp T        &kp Y  &kp U        &kp I        &kp O       &kp P          &del_cad 0 DEL
&lang_tab TAB 0     &hml LGUI A &hml LALT S &hml LCTRL D &hml LSHFT F &kp G        &kp H  &hmr LSHFT J &hmr LCTRL K &hmr LALT L &hmr RGUI SEMI &kp APOS
&caps_word          &kp Z       &kp X       &kp C        &kp V        &kp B        &kp N  &kp M        &kp COMMA    &kp DOT     &kp FSLH       &p_slash
                                &lt 2 ESC   &lt 1 SPACE  &ctp LCTRL 0                     &lt 3 RET    &lt 1 BSPC   &mo 3
            >;
        };


        layer_1 {
            label = "Nav/Symbol";
            bindings = <
&trans      &kp N1    &kp N2    &kp N3    &kp N4    &kp N5          &kp N6            &kp N7             &kp N8            &kp N9            &kp N0     &kp DEL
&kp GRAVE   &kp LBRC  &kp RBRC  &kp LPAR  &kp RPAR  &eq_tilde       &nav_hp HOME LEFT &nav_hp PG_DN DOWN &nav_hp PG_UP UP  &nav_hp END RIGHT &kp STAR   &kp HASH
&kp EXCL    &kp LBKT  &kp RBKT  &kp UNDER &kp MINUS &kp PLUS        &kp AT            &kp DLLR           &kp AMPS          &kp PRCNT         &kp CARET  &trans
                      &trans    &trans    &trans                                      &trans             &trans            &trans
            >;
        };


        layer_2 {
            label = "FN/MID/BT";
            bindings = <
&kp F11      &kp F1       &kp F2       &kp F3       &kp F4       &kp F5            &kp F6     &kp F7     &kp F8       &kp F9       &kp F10 &kp F12
&out OUT_TOG &none        &none        &none        &none        &none             &kp C_MUTE &kp C_PP   &kp C_VOL_DN &kp C_VOL_UP &none   &none
&none        &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4      &kp C_PREV &kp C_RW   &kp C_FF     &kp C_NEXT   &none   &bootloader
                          &trans       &none        &bt BT_CLR_ALL                            &none      &none        &bt BT_CLR 
            >;
        }; 


        layer_3 {
            label = "AutoMouse";   //Pure Mouse (Auto-activated)
            bindings = <
&trans   &kp F2    &kp LC(W)       &kp LC(LS(T))  &kp F5        &kp LC(T)       &mkp LCLK &mo 5     &mo 4     &none  &mkp MB5  &trans
&trans   &mkp MCLK &mkp RCLK       &mo 5          &mkp LCLK     &mkp MB4        &mkp LCLK &mkp RCLK &mkp MCLK &none  &mkp MB4  &none
&none    &trans    &kp LC(LS(TAB)) &kp LC(TAB)    &kp LC(LS(V)) &mkp MB5        &none     &none     &none     &none  &none     &none
                   &trans          &kp LSHFT      &trans                                  &trans    &trans    &trans 
            >;
        };


        layer_4 {
            label = "SlowMouse";   //AutoMouse Layer와 동일 
            bindings = < 
&trans   &kp F2    &kp LC(W)       &kp LC(LS(T))  &kp F5        &kp LC(T)       &mkp LCLK &mo 5     &mo 4     &none  &mkp MB5  &trans
&trans   &mkp MCLK &mkp RCLK       &mo 5          &mkp LCLK     &mkp MB4        &mkp LCLK &mkp RCLK &mkp MCLK &none  &mkp MB4  &none
&none    &trans    &kp LC(LS(TAB)) &kp LC(TAB)    &kp LC(LS(V)) &mkp MB5        &none     &none     &none     &none  &none     &none
                   &trans          &kp LSHFT      &trans                                  &trans    &trans    &trans 
            >;
        };


       layer_5 {
           label = "ScrollOnly";
           bindings = <
// 모든 키를 &trans로 설정하여 이전 레이어의 마우스 버튼 입력을 투과시킵니다.
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                    &trans &trans &trans    &trans &trans &trans
           >;
       };




    };
};
